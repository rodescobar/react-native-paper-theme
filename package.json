{
  "name": "react-native-paper-theme-creator",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "clean:deploy": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('docs',{recursive:true,force:true});\"",
    "prepare:pages": "node -e \"const fs=require('fs');fs.renameSync('dist','docs');fs.writeFileSync('docs/.nojekyll','');const p='docs/index.html';let s=fs.readFileSync(p,'utf8');s=s.replace('src=\\\"/_expo/','src=\\\"./_expo/');fs.writeFileSync(p,s);\"",
    "deploy": "npm run clean:deploy && npm run export:web && npm run prepare:pages"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.15",
    "@mdi/js": "^7.4.47",
    "expo": "57.0.21",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2"
  }
}